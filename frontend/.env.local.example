# Copy to .env.local for Next.js dev
#
# Default (omit NEXT_PUBLIC_API_URL): browser uses same-origin /api/* — Next.js proxies to FastAPI.
# Set API_PROXY_TARGET if the API is not at http://127.0.0.1:8000 (default).
# API_PROXY_TARGET=http://127.0.0.1:8000
#
# WebSockets still connect to FastAPI directly (Next does not proxy WS reliably). Override if needed:
# NEXT_PUBLIC_API_WS_ORIGIN=ws://127.0.0.1:8000
#
# Optional: call FastAPI directly from the browser for HTTP too (needs CORS + working localhost:8000).
# NEXT_PUBLIC_API_URL=http://localhost:8000
# To force direct localhost even when NEXT_PUBLIC_API_URL is set to localhost:8000 in dev:
# NEXT_PUBLIC_API_DIRECT=true
# Optional transparency UI flags
# NEXT_PUBLIC_AGENT_GRAPH_ENABLED=true
# NEXT_PUBLIC_SCRATCHPAD_VISIBLE=true

# Optional: self-hosted diagrams.net (draw.io) editor base URL.
# - HTTP:  http://localhost:8081
# - HTTPS: https://localhost:8444
# Must support iframe embed mode (embed=1) for collaboration.
# If omitted, frontend defaults to hosted diagrams.net: https://app.diagrams.net
NEXT_PUBLIC_DRAWIO_BASE_URL=https://localhost:8444
