# Local development (copy to .env and load, or export in shell)
# No Docker required: SQLite is the default if DATABASE_URL is unset.

# development | staging | production
# PROCESSDOC_ENV=development

# Required in every environment: min 16 characters, not the literal "change-me".
# Generate locally: `make dev.secret` (repo root) or `python -c "import secrets; print(secrets.token_urlsafe(32))"`
JWT_SECRET=change-me-to-a-long-random-string
WORKSPACE_ROOT=./workspace

# Short-lived API access token (minutes) and long-lived refresh token (days) for /api/auth/refresh
# JWT_ACCESS_EXP_MINUTES=60
# JWT_REFRESH_EXP_DAYS=7
# JWT_SSE_EXP_SECONDS=90
# Short-lived SSE-only tokens: POST /api/auth/sse-token with Bearer access JWT
# When run_id is set, the user must be a member of that run's project (Owner/Editor/Viewer).
#
# SlowAPI rate limits for auth endpoints (e.g. 30/minute). See backend/app/core/rate_limit.py.
# AUTH_LOGIN_RATE_LIMIT=30/minute
# AUTH_REFRESH_RATE_LIMIT=60/minute

# Comma-separated emails allowed to mutate the shared leading_practice wiki (ingest, sync, etc.).
# Reads are always available to any authenticated user. Empty list:
#   - development: any authenticated user may mutate LP (legacy behavior)
#   - staging/production: all LP mutations are denied (403). Configure admins here.
# WIKI_LP_ADMIN_EMAILS=admin@example.com,ops@example.com

# Coordinator pre-search: when the user's instruction reads like a search
# request ("find / look up / research …"), the coordinator runs wiki + web
# searches before context assembly so every subagent sees the results.
# Disable either leg to cap cost, latency, or outbound-network usage.
# Web leg requires BRAVE_SEARCH_API_KEY or GOOGLE_CUSTOM_SEARCH_{API_KEY,CX}
# (when no key is set the leg returns empty and costs nothing).
# COORDINATOR_PRE_SEARCH_ENABLED=true
# COORDINATOR_PRE_SEARCH_WEB_ENABLED=true

# Trust X-Forwarded-For / X-Forwarded-Proto from upstream proxies so SlowAPI
# rate limits key on the real client IP, not the proxy IP. Enable ONLY when
# the API runs behind a trusted reverse proxy (ALB, nginx, Cloudflare). Set
# TRUST_FORWARDED_FOR_HOSTS to the proxy addresses (comma-separated) or "*".
# TRUST_FORWARDED_FOR_ENABLED=false
# TRUST_FORWARDED_FOR_HOSTS=127.0.0.1

# 0 = no aggregate cap; otherwise max input+output tokens per run (enforced in Claude client path)
# ANTHROPIC_MAX_TOKENS_PER_RUN=0

# Optional: Redis for shared parse cache across processes (omit for single-process local dev)
# REDIS_URL=redis://localhost:6379/0
# Optional: run execution queue backend
# RUN_QUEUE_BACKEND=local  # values: local, redis (default local)
# Happy-path verification (no worker = stalled after approve):
#   - local: in-process consumer starts on enqueue (good for solo dev).
#   - redis: requires Redis reachable AND (RUN_QUEUE_EMBED_REDIS_CONSUMER=true on the API, OR
#     a separate process: `cd backend && python -m app.workers.run_execution_worker`).
#   Check POST .../approve → 200; then GET .../events for step payloads execution_enqueued → execution_started.
# After API restart, re-queue local-queue runs stuck at execution_enqueued (default true). Disable if needed:
# RUN_QUEUE_STARTUP_RECONCILE=false
# If redis: either run `python -m app.workers.run_execution_worker` alongside the API, or for solo dev:
# RUN_QUEUE_EMBED_REDIS_CONSUMER=true
# RUN_EXECUTION_QUEUE_NAME=processdoc:run-execution
# RUN_WORKER_ID=worker-1
# RUN_WORKER_HEARTBEAT_KEY_PREFIX=processdoc:run-worker:heartbeat
# RUN_WORKER_HEARTBEAT_TTL_SEC=20
# Admission control / fairness caps
# RUN_MAX_ACTIVE_GLOBAL=500
# RUN_MAX_ACTIVE_PER_PROJECT=20
# RUN_MAX_ACTIVE_PER_USER=8
# RUN_DEAD_LETTER_MAX_REPLAY_ATTEMPTS=3
# Instruction UX and transparency feature flags
# INSTRUCTION_DECISION_PROMPTS_ENABLED=true
# SCRATCHPAD_VISIBILITY_ENABLED=true
# Optional: extra Anthropic call to propose 2–4 execution strategy options + execution_strategy decision prompt (off by default)
# STRATEGY_OPTIONS_PLANNING_ENABLED=false
# Swarm orchestration: DAG-backed run tasks, team/teammate rows, messaging API, Run Studio panel (off by default).
# SWARM_ORCHESTRATION_ENABLED=false
# SWARM_GIT_WORKTREES_ENABLED=false
# SWARM_EXECUTE_CUSTOM_TASKS_ENABLED=false
# Optional future hook for LLM-authored task graphs (requires Claude + flag).
# SWARM_LLM_LEAD_ENABLED=false
# Project memory: MEMORY_COMPACTION_V1_ENABLED + MEMORY_V2_RETRIEVAL_ENABLED work together.
# If compaction is true but v2 retrieval is false, Memory page items are NOT merged (events/profile still apply); API logs a warning at startup.
# MEMORY_COMPACTION_V1_ENABLED=true   # merge MemoryItem/MemoryEvent/profile into assembled_context (default on)
# MEMORY_V2_RETRIEVAL_ENABLED=true      # load MemoryItem rows into context (default on)
# MEMORY_RESPECT_CONSENT_IN_CONTEXT=true
# MEMORY_ENFORCE_CONSENT_LEDGER=false   # if true, MemoryItem.principal_id requires Consent Ledger grant
# MEMORY_BATCH_CREATE_ENABLED=true
# MEMORY_COMPACTION_CHAR_CAP=32000
# MEMORY_EVENTS_RETENTION_DAYS=30

# Default when unset: sqlite:///./processdoc.db (see Settings in app/core/config.py).
# Local Postgres examples:
# DATABASE_URL=sqlite:///./processdoc.db
# DATABASE_URL=postgresql+psycopg://processdoc:processdoc@localhost:5432/processdoc
# Pool tuning (non-SQLite only; align with Uvicorn workers × Postgres max_connections)
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# DATABASE_POOL_PRE_PING=true
# Multi-replica: require Redis for shared cache (fail startup if Redis down)
# CACHE_ALLOW_MEMORY_FALLBACK=true

# Optional: comma-separated origins for browser clients (default includes localhost:3000)
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional: Anthropic Claude (used for all agentic generations when set)
ANTHROPIC_API_KEY=your_api_key_here
ANTHROPIC_CLAUDE_MODEL=claude-haiku-4-5
ANTHROPIC_TEMPERATURE=0.2
ANTHROPIC_MAX_TOKENS=4096
# COORDINATOR_LLM_PLANNING_ENABLED=true
# ANTHROPIC_THINKING_BUDGET_TOKENS=8000
# ANTHROPIC_COORDINATOR_PLAN_MAX_TOKENS=8192
# Cowork-style context (conversation digest, planner grounding excerpt, optional narrative thinking)
# CONVERSATION_DIGEST_MAX_CHARS=12000
# CONVERSATION_DIGEST_MESSAGE_LIMIT=45
# COORDINATOR_PLANNING_CONTEXT_CHARS=7000
# SUBAGENT_CONVERSATION_DIGEST_MAX_CHARS=3500
# SUBAGENT_NARRATIVE_THINKING_ENABLED=false
# ANTHROPIC_SUBAGENT_THINKING_BUDGET_TOKENS=8000

# Optional: Langfuse tracing (run-level observability)
# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# Optional: Anthropic Bash tool (Owner/Editor only; see infra/bash_tool_security.md)
# BASH_TOOL_ENABLED=false
# BASH_TOOL_MODEL=
# BASH_SESSION_TIMEOUT_SEC=3600
# BASH_COMMAND_TIMEOUT_SEC=120
# BASH_MAX_OUTPUT_BYTES=65536
# BASH_MAX_OUTPUT_LINES=400
# BASH_MAX_TOOL_ROUNDS=12
# BASH_ALLOWLIST_ENABLED=false
# BASH_ALLOWLIST_COMMANDS=bash,sh,ls,cat,echo,pwd,head,tail,wc,grep,find,git,python,python3,pytest,node,npm
# BASH_FORBID_OPERATORS=true
# BASH_AUDIT_LOG=
# BASH_DOCKER_ENABLED=false
# BASH_DOCKER_IMAGE=alpine:3.20
# Host path to Docker seccomp JSON (optional hardening)
# BASH_DOCKER_SECCOMP_PROFILE=
# BASH_RATE_LIMIT_PER_MINUTE=20
# OpenTelemetry SDK bootstrap (requires opentelemetry-sdk); console exporter stub
# OTEL_SDK_ENABLED=false

# Optional: Anthropic Text Editor tool (Owner/Editor only; read-only by default per request)
# TEXT_EDITOR_TOOL_ENABLED=false
# TEXT_EDITOR_TOOL_MODEL=
# TEXT_EDITOR_MAX_CHARACTERS=12000
# TEXT_EDITOR_BACKUP_ENABLED=true
# TEXT_EDITOR_AUDIT_LOG=
# TEXT_EDITOR_ALLOWED_EXTENSIONS=.py,.md,.txt,.json,.yaml,.yml,.toml,.ini,.cfg,.csv,.ts,.tsx,.js,.jsx,.html,.css,.sql,.xml,.env,.sh
# TEXT_EDITOR_MAX_FILE_BYTES=5242880

# Max upload size for multipart endpoints (bytes, default 52428800)
# UPLOAD_MAX_BYTES=52428800

# Deliverable quality: config/quality_contracts/registry.json + *.json (optional override directory)
# DELIVERABLE_QUALITY_ENABLED=true
# DELIVERABLE_QUALITY_MAX_REVISION_ROUNDS=2
# QUALITY_CONTRACTS_DIR=

# Frontend environment lives in frontend/.env.local (see frontend/.env.local.example)
# NEXT_PUBLIC_API_URL=http://localhost:8000
