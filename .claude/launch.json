{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "cwd": "frontend",
      "port": 3000,
      "autoPort": false
    },
    {
      "name": "backend-dev",
      "runtimeExecutable": "uvicorn",
      "runtimeArgs": ["app.main:app", "--reload"],
      "cwd": "backend",
      "port": 8000,
      "autoPort": false
    }
  ]
}
